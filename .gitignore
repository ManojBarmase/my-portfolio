# ==============================================================================
# Enterprise-Grade .gitignore for Next.js 16+ / React 19 / TypeScript Portfolio
# ==============================================================================

# --- Node & Dependencies ---
node_modules/
/.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js Build & Outputs ---
.next/
/out/
/build/
/dist/
/.turbo/

# --- Environment & Secret Security (NEVER COMMIT SECRETS) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env.backup

# Explicit exception: Allow sanitized example templates
!.env.example
!.env.template

# --- Security Certificates & Keys ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
secrets.json
credentials.json

# --- Testing & Coverage ---
/coverage/
/.nyc_output/
*.lcov

# --- Logs & Diagnostics ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- TypeScript Build Info ---
*.tsbuildinfo
next-env.d.ts

# --- Vercel & Deployment Tooling ---
.vercel

# --- Operating System Artifacts ---
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# Linux
*~
.directory

# --- IDE & Editor Artifacts ---
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# --- AI & Agent Workspace Directories ---
.gemini/
.claude/
.cursor/
.codeium/
